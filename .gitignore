# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore bundler config.
/.bundle

# Ignore environment files except .env.example
/.env
/.env.local
/.env.*.local

# Ignore SSL certificates (local development only)
*.pem
*.key
*.crt
*.cert

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

# Ignore master key for decrypting credentials and more.
/config/master.key
config/master.key
config/credentials/*.key
node_modules/
storage/*
*.bak.DELETED

/config/credentials/staging.key
# Local test and setup scripts
create_test_invitation.rb
test_*.rb
setup_*.sh
setup_*.bat
script/create_portal_user_templates.rb

# Local helper files
DEPLOYMENT_INSTRUCTIONS.md
STAGING_FIXES_SUMMARY.md
push_fixes_to_staging.sh
verify_staging_api.sh
test_portal_registration.sh
PORTAL_REGISTRATION_COMPLETE.md
