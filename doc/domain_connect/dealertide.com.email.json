{
  "providerId": "dealertide.com",
  "providerName": "DealerTide",
  "serviceId": "email",
  "serviceName": "DealerTide Campaign Email",
  "version": 1,
  "logoUrl": "https://app.dealertide.com/logo.png",
  "description": "Authorizes DealerTide to send campaign email from your domain, signed with your own DKIM keys.",
  "syncBlock": true,
  "syncPubKeyDomain": "dealertide.com",
  "records": [
    {
      "type": "CNAME",
      "host": "%dkim1%._domainkey",
      "pointsTo": "%dkim1%.dkim.amazonses.com",
      "ttl": 1800
    },
    {
      "type": "CNAME",
      "host": "%dkim2%._domainkey",
      "pointsTo": "%dkim2%.dkim.amazonses.com",
      "ttl": 1800
    },
    {
      "type": "CNAME",
      "host": "%dkim3%._domainkey",
      "pointsTo": "%dkim3%.dkim.amazonses.com",
      "ttl": 1800
    },
    {
      "type": "MX",
      "host": "%mailfrom%",
      "pointsTo": "feedback-smtp.%sesregion%.amazonses.com",
      "priority": 10,
      "ttl": 1800
    },
    {
      "type": "SPFM",
      "host": "%mailfrom%",
      "spfRules": "include:amazonses.com",
      "ttl": 1800
    }
  ]
}
