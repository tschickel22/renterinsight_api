# ============================================
# DATABASE CONFIGURATION (PostgreSQL)
# ============================================
# Local Development: Use Docker Postgres container
# Example: docker run --name pg-local -e POSTGRES_PASSWORD=postgres -e POSTGRES_USER=postgres -e POSTGRES_DB=ri_dms_dev -p 5432:5432 -d postgres:16
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ri_dms_dev

# Staging/Production: Render provides DATABASE_URL automatically
# No need to set this manually on Render

# ============================================
# JWT AUTHENTICATION SECRETS
# ============================================
# CRITICAL: Change these in production!
# Generate secure random strings: openssl rand -hex 64
JWT_SECRET=your-jwt-secret-key-change-in-production
JWT_REFRESH_SECRET=your-refresh-token-secret-key-change-in-production

# ============================================
# FRONTEND & PORTAL URLS
# ============================================
# Local Development
FRONTEND_URL=https://localhost:5173
PORTAL_URL=https://localhost:5173

# Staging
# FRONTEND_URL=https://staging.crm.landlordinsight.com
# PORTAL_URL=https://staging.crm.landlordinsight.com

# Production
# FRONTEND_URL=https://crm.landlordinsight.com
# PORTAL_URL=https://crm.landlordinsight.com

# ============================================
# EMAIL CONFIGURATION
# ============================================
MAILER_FROM=noreply@renterinsight.com

# ============================================
# SMS CONFIGURATION (Optional - Twilio)
# ============================================
# Uncomment to enable SMS functionality
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=your_account_sid
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_PHONE_NUMBER=+1234567890

# ============================================
# SETUP TOKEN (One-time initialization)
# ============================================
# Used for initial setup endpoint on Render free tier
SETUP_TOKEN=your-setup-token-change-in-production

# ============================================
# RAILS ENVIRONMENT
# ============================================
# Render sets this automatically, but can be set locally
# RAILS_ENV=development
# RAILS_LOG_LEVEL=info
# RAILS_MAX_THREADS=10

# ============================================
# CORS CONFIGURATION
# ============================================
# Usually handled in code, but can be overridden
# CORS_ALLOWED_ORIGINS=https://localhost:5173,https://staging.crm.landlordinsight.com
