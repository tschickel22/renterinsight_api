# ╔══════════════════════════════════════════════════════════════════════╗
# ║  Platform DMS — Environment Variables                               ║
# ║                                                                      ║
# ║  Copy this file to .env and fill in values for local development.    ║
# ║  Staging/production values are set in Render's dashboard.            ║
# ║  Lines beginning with # are comments; uncomment to enable.          ║
# ╚══════════════════════════════════════════════════════════════════════╝


# ============================================
# 1. DATABASE (PostgreSQL)
# ============================================
# Primary database connection string.
# Local dev: run `docker start pg-local` or use Postgres.app.
# Staging/Production: provided automatically by Render.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ri_dms_dev

# Separate databases for cache, queue, and cable (staging/production only).
# If unset, derived from DATABASE_URL with a suffix swap.
# CACHE_DATABASE_URL=
# QUEUE_DATABASE_URL=
# CABLE_DATABASE_URL=


# ============================================
# 2. RAILS
# ============================================
# RAILS_ENV=development
# RAILS_LOG_LEVEL=info                  # debug | info | warn | error
# RAILS_MAX_THREADS=10                  # DB pool size & Puma thread count
# RAILS_MASTER_KEY=                     # Decrypts config/credentials.yml.enc (production only)
PORT=3001


# ============================================
# 3. PUMA / SERVER
# ============================================
# WEB_CONCURRENCY=2                     # Puma worker processes (production only, omit in dev)
# PIDFILE=                              # Custom PID file path (rarely needed)
# SOLID_QUEUE_IN_PUMA=false             # Run Solid Queue supervisor inside Puma
# PWK_RAM=480                           # Max RSS (MB) for puma_worker_killer (production)


# ============================================
# 4. JWT AUTHENTICATION
# ============================================
# CRITICAL: generate unique secrets for production!
#   openssl rand -hex 64
JWT_SECRET=
JWT_REFRESH_SECRET=


# ============================================
# 5. ACTIVE RECORD ENCRYPTION
# ============================================
# Used for encrypting sensitive model attributes at rest.
# In dev/test these auto-generate from a base key if unset.
# In staging/production you MUST set real values.
#   bin/rails db:encryption:init   (generates all three)
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# Encrypts stored SMTP passwords, API keys in Settings table.
# Falls back to Rails secret_key_base if unset.
# SETTINGS_ENCRYPTION_KEY=


# ============================================
# 6. FRONTEND & PORTAL URLS
# ============================================
# Where the React frontend and buyer portal are hosted.
FRONTEND_URL=https://localhost:5173
PORTAL_URL=https://localhost:5173

# Backend API URL (used by agreement signing, PDF generation, etc.)
# RAILS_API_URL=https://localhost:3001
# APP_URL=http://localhost:3000
# APP_BASE_URL=https://app.platformdms.com
# API_BASE_URL=https://renterinsight-api-staging.onrender.com

# Staging/Production host overrides (Render sets RENDER_EXTERNAL_URL automatically)
# RENDER_EXTERNAL_URL=
# API_HOST=
# STAGING_HOST=renterinsight-api-staging.onrender.com


# ============================================
# 7. CORS
# ============================================
# Comma-separated list of allowed origins. Falls back to a hardcoded
# allowlist in config/initializers/cors.rb if unset.
# CORS_ORIGINS=https://localhost:5173,https://staging.crm.landlordinsight.com


# ============================================
# 8. EMAIL — GENERAL
# ============================================
MAILER_FROM=noreply@renterinsight.com
# EMAIL_FROM=platform@renterinsight.com
# EMAIL_FROM_NAME=RenterInsight
# PORTAL_FROM_EMAIL=portal@renterinsight.com
# QUOTE_FROM_EMAIL=quotes@platformdms.com
# DEFAULT_EMAIL_PROVIDER=smtp            # smtp | aws_ses | gmail_relay | sendgrid
# DEFAULT_FROM_EMAIL=noreply@platformdms.com
# DEFAULT_FROM_NAME=Platform DMS
# EMAIL_PROVIDER=smtp
# EMAIL_ENABLED=true                     # Set to "false" to disable all outbound email


# ============================================
# 9. EMAIL — SMTP
# ============================================
# Only needed if EMAIL_PROVIDER=smtp (or using the platform-level SMTP fallback).
# SMTP_ADDRESS=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_DOMAIN=example.com
# SMTP_AUTHENTICATION=plain              # plain | login | cram_md5


# ============================================
# 10. EMAIL — AWS SES
# ============================================
# Only needed if EMAIL_PROVIDER=aws_ses.
# AWS_SES_REGION=us-east-1
# AWS_SES_CONFIGURATION_SET=platform-dms-emails


# ============================================
# 11. EMAIL — SENDGRID
# ============================================
# Only needed if EMAIL_PROVIDER=sendgrid.
# SENDGRID_API_KEY=


# ============================================
# 12. AWS (S3 for website assets / media uploads)
# ============================================
# Required for website builder media uploads and brochure asset storage.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-west-2
# AWS_S3_BUCKET=renterinsight-website-assets-staging


# ============================================
# 13. SMS — TWILIO
# ============================================
# Uncomment and fill to enable SMS (lead notifications, MFA codes, etc.).
# SMS_PROVIDER=twilio
# SMS_ENABLED=false                      # "true" to enable outbound SMS
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=+15551234567
# TWILIO_MESSAGING_SERVICE_SID=          # For A2P 10DLC registered messaging
# TWILIO_FROM_NUMBER=                    # Alternative to TWILIO_PHONE_NUMBER
# SMS_FROM_NUMBER=                       # Platform-level override


# ============================================
# 14. QUICKBOOKS INTEGRATION
# ============================================
# OAuth credentials for QuickBooks Online sync.
# Also checked in Rails.application.credentials.
# QUICKBOOKS_CLIENT_ID=
# QUICKBOOKS_CLIENT_SECRET=
# QUICKBOOKS_ENVIRONMENT=sandbox         # sandbox | production


# ============================================
# 15. ZEGO PAYMENT INTEGRATION
# ============================================
# Also checked in Rails.application.credentials.
# ZEGO_URL=
# ZEGO_ADMIN_URL=
# ZEGO_GATEWAY_ID=
# ZEGO_LOGIN=
# ZEGO_PASSWORD=
# ZEGO_PAYEE_ID=
# ZEGO_ADMIN_API_KEY=
# ZEGO_ADMIN_USERNAME=
# ZEGO_ADMIN_PASSWORD=


# ============================================
# 16. OAUTH — EMAIL PROVIDERS
# ============================================
# Microsoft Graph (Outlook) OAuth for user email connections.
# Also checked in Rails.application.credentials.
# MICROSOFT_OAUTH_CLIENT_ID=
# MICROSOFT_OAUTH_CLIENT_SECRET=


# ============================================
# 17. AI / LLM (Anthropic Claude)
# ============================================
# Powers report-AI, AI insights, agreement smart-scan, etc.
# Also checked in Rails.application.credentials.
# ANTHROPIC_API_KEY=


# ============================================
# 18. CLOUDFLARE (Custom Domains)
# ============================================
# Used by the custom-domain SSL provisioning service.
# Configured in Rails.application.credentials, not typically in .env.
# CLOUDFLARE_ZONE_ID=
# CLOUDFLARE_API_TOKEN=


# ============================================
# 19. CDN & UPLOADS
# ============================================
# CDN_DOMAIN=                            # CDN origin for website media URLs
# UPLOAD_PATH=                            # Defaults to Rails.root/public/uploads


# ============================================
# 20. BRANDING / PLATFORM DEFAULTS
# ============================================
# These have hardcoded defaults in PlatformSetting but can be overridden.
# PLATFORM_NAME=RenterInsight
# PORTAL_NAME=Customer Portal
# SUPPORT_EMAIL=support@renterinsight.com
# COMPANY_NAME=Platform DMS
# BUYER_PORTAL_URL=


# ============================================
# 21. BACKGROUND JOB SCHEDULERS
# ============================================
# These run automatically in development. In production, set to "true"
# to enable the recurring Solid Queue schedules.
# ENABLE_AI_DIGEST_SCHEDULER=false
# ENABLE_EMAIL_SYNC_SCHEDULER=false
# ENABLE_REMINDER_SCHEDULER=false


# ============================================
# 22. NOTIFICATIONS
# ============================================
# CONTRACTOR_NOTIFICATION_DELAY_MINUTES=10
# DEALER_REVIEW_NOTIFICATION_DELAY_MINUTES=10


# ============================================
# 23. SETUP & ONBOARDING
# ============================================
# One-time token for the /setup endpoint (initial platform bootstrap).
SETUP_TOKEN=


# ============================================
# 24. DEMO / SEED DATA (dev only)
# ============================================
# DEMO_PREFIX=sunshine
# DEMO_NAME=Sunshine MH Homes
# RESET=false


# ============================================
# 25. CI / TEST
# ============================================
# CI=true                                # Set automatically by GitHub Actions
