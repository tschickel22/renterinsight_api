<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <style>
    body { font-family: Arial, sans-serif; line-height: 1.6; color: #1f2937; background: #f9fafb; margin: 0; padding: 0; }
    .container { max-width: 620px; margin: 0 auto; padding: 24px; background: white; }
    .header { padding: 8px 0 16px; border-bottom: 2px solid #e5e7eb; }
    h1 { font-size: 20px; margin: 8px 0 4px; }
    .sub { color: #6b7280; font-size: 14px; }
    .badge { display: inline-block; background: #dbeafe; color: #1d4ed8; padding: 3px 10px; border-radius: 999px; font-size: 12px; text-transform: uppercase; letter-spacing: 0.04em; }
    .badge.platform-instagram { background: #fce7f3; color: #be185d; }
    .quote { border-left: 4px solid #2563eb; padding: 12px 16px; margin: 18px 0; background: #f3f4f6; color: #111827; white-space: pre-line; border-radius: 0 6px 6px 0; }
    .post-preview { margin-top: 18px; padding: 12px 14px; border: 1px solid #e5e7eb; border-radius: 8px; background: #f9fafb; color: #374151; font-size: 14px; }
    .cta { margin: 24px 0 12px; }
    .btn { display: inline-block; padding: 12px 22px; margin-right: 10px; border-radius: 6px; text-decoration: none; font-weight: 600; }
    .btn-primary { background: #2563eb; color: #ffffff; }
    .btn-secondary { background: #e5e7eb; color: #111827; }
    .footer { margin-top: 32px; padding-top: 16px; border-top: 1px solid #e5e7eb; color: #6b7280; font-size: 12px; }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <span class="badge platform-<%= @post&.platform %>"><%= @post&.platform.to_s.titleize.presence || 'Social' %></span>
      <h1><%= @comment.author_name.presence || 'Someone' %> commented on your post</h1>
      <div class="sub">Hi <%= @recipient.first_name.presence || @recipient.email %>, a new comment just landed.</div>
    </div>

    <div class="quote"><%= @comment.message.to_s %></div>

    <% if @post.present? %>
      <div class="post-preview">
        <strong><%= @post.headline.presence || 'Your post' %></strong>
        <% if @post.caption.present? %><br/><%= truncate(@post.caption, length: 220) %><% end %>
      </div>
    <% end %>

    <div class="cta">
      <a href="<%= @reply_url %>" class="btn btn-primary">Reply in <%= brand.name %></a>
      <% if @facebook_url.present? %>
        <a href="<%= @facebook_url %>" class="btn btn-secondary">View on <%= @post&.platform.to_s == 'instagram' ? 'Instagram' : 'Facebook' %></a>
      <% end %>
    </div>

    <div class="footer">
      You're receiving this because <%= @company&.name || 'your company' %> has you listed as a recipient for social comment notifications. Manage these preferences in Marketing → Social Media → Settings.
    </div>
  </div>
</body>
</html>
