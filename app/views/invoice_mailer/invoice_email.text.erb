<%= @company.name %>
<% if @location.present? %><% if @location.phone.present? %><%= @location.phone %>
<% end %><% if @location.address_line1.present? %><%= [@location.address_line1, @location.city, @location.state, @location.zip_code].compact.join(', ') %>
<% end %><% if @location.email.present? %><%= @location.email %><% end %><% end %>
