<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <style>
    body { font-family: Arial, sans-serif; line-height: 1.6; color: #333; }
    .container { max-width: 600px; margin: 0 auto; padding: 20px; }
    .header { text-align: center; padding: 20px 0; border-bottom: 2px solid #e5e7eb; }
    .logo { max-width: 200px; height: auto; }
    .success-badge { background: #10b981; color: white; padding: 10px 20px; border-radius: 6px; display: inline-block; margin: 20px 0; }
    .payment-details { background: #f9fafb; padding: 20px; border-radius: 8px; margin: 20px 0; }
    .detail-row { display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid #e5e7eb; }
    .footer { text-align: center; padding: 20px 0; color: #6b7280; font-size: 0.9em; border-top: 1px solid #e5e7eb; margin-top: 40px; }
    .btn { display: inline-block; padding: 12px 24px; background: #dc2626; color: white; text-decoration: none; border-radius: 6px; margin: 20px 0; }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <h1><%= @company_name %></h1>
      <div class="success-badge">✓ Payment Received</div>
    </div>
    
    <div style="margin: 30px 0;">
      <h2>Loan Payment Receipt</h2>
      <p>Thank you for your payment! We have successfully received your payment for Loan <%= @loan.loan_number %>.</p>
    </div>
    
    <div class="payment-details">
      <div class="detail-row">
        <span><strong>Loan Number:</strong></span>
        <span><%= @loan.loan_number %></span>
      </div>
      
      <div class="detail-row">
        <span><strong>Payment Date:</strong></span>
        <span><%= @payment.processed_at&.strftime('%B %d, %Y at %I:%M %p') || @payment.payment_date.strftime('%B %d, %Y') %></span>
      </div>
      
      <% if @payment.payment_method.present? %>
        <div class="detail-row">
          <span><strong>Payment Method:</strong></span>
          <span><%= @payment.payment_method.method_type.titleize %></span>
        </div>
      <% end %>
      
      <div class="detail-row">
        <span><strong>Payment Amount:</strong></span>
        <span style="font-size: 1.2em; color: #10b981;"><%= number_to_currency(@payment.amount) %></span>
      </div>
      
      <% if @payment.external_id.present? %>
        <div class="detail-row">
          <span><strong>Transaction ID:</strong></span>
          <span><%= @payment.external_id %></span>
        </div>
      <% end %>
      
      <% if @payment.notes.present? %>
        <div class="detail-row">
          <span><strong>Notes:</strong></span>
          <span><%= @payment.notes %></span>
        </div>
      <% end %>
    </div>
    
    <div style="background: #fef3c7; padding: 15px; border-radius: 6px; margin: 20px 0;">
      <strong>Loan Summary:</strong><br>
      Original Principal: <%= number_to_currency(@loan.principal_amount) %><br>
      Total Paid: <%= number_to_currency(@loan.total_paid || 0) %><br>
      <strong>Remaining Balance: <%= number_to_currency(@loan.current_balance) %></strong>
      <% if @loan.next_payment_date.present? %>
        <br><br>
        <strong>Next Payment Due:</strong> <%= @loan.next_payment_date.strftime('%B %d, %Y') %>
      <% end %>
    </div>
    
    <% if @loan.current_balance <= 0 %>
      <div style="text-align: center; padding: 20px; background: #d1fae5; border-radius: 8px; margin: 20px 0;">
        <strong style="color: #10b981; font-size: 1.2em;">✓ Loan Paid in Full</strong>
        <p style="margin-top: 10px;">Congratulations! Your loan has been paid off completely.</p>
      </div>
    <% end %>
    
    <div style="text-align: center; margin: 30px 0;">
      <a href="<%= @loan_url %>" class="btn">View Loan Details</a>
    </div>
    
    <div class="footer">
      <p>If you have any questions about this payment, please contact us.</p>
      <p><%= @company_name %></p>
      <p>This is an automated receipt for your records.</p>
    </div>
  </div>
</body>
</html>
