<p>Hi<%= " #{@name}" if @name.present? %>,</p>
<% if @method == 'CANCEL' %>
  <p>This appointment<%= " with #{@company.name}" if @company %> has been cancelled: <strong><%= @subject_line %></strong>, <%= @when_text %>.</p>
<% else %>
  <p>You have an appointment<%= " with #{@company.name}" if @company %>: <strong><%= @subject_line %></strong>, <%= @when_text %><%= " at #{@place}" if @place.present? %>.</p>
  <p>The attached invite adds it to your calendar. If it changes, you will get an updated one.</p>
<% end %>
