<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
      line-height: 1.6;
      color: #1f2937;
      background-color: #ffffff;
      margin: 0;
      padding: 0;
    }
    .container { max-width: 640px; margin: 0 auto; padding: 24px 20px; }
    .meta { color: #6b7280; font-size: 13px; margin-bottom: 4px; }
    .meta strong { color: #374151; }
    .body { white-space: pre-wrap; word-wrap: break-word; color: #1f2937; font-size: 15px; margin-top: 16px; }
    .sep { border: none; border-top: 1px solid #e5e7eb; margin: 28px 0 14px; }
    .footer { color: #9ca3af; font-size: 12px; }
    .footer a { color: #6b7280; }
  </style>
</head>
<body>
  <div class="container">
    <div class="meta"><strong><%= @entity_name %></strong> &lt;<%= @from_address %>&gt;</div>
    <div class="meta"><strong>Subject:</strong> <%= @subject %></div>

    <div class="body"><%= @reply_body %></div>

    <hr class="sep">
    <p class="footer">
      Reply to this email to respond to <%= @entity_name %>.
      &nbsp;·&nbsp; <a href="<%= @full_link %>">Open in Renter Insight</a>
    </p>
  </div>
</body>
</html>
