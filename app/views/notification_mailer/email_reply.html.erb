<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    body { 
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
      line-height: 1.6; 
      color: #1f2937;
      background-color: #f9fafb;
      margin: 0;
      padding: 0;
    }
    .container { 
      max-width: 600px; 
      margin: 0 auto; 
      background: white;
      border-radius: 8px;
      overflow: hidden;
    }
    .header { 
      text-align: center; 
      padding: 30px 20px; 
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: white;
    }
    .content { 
      padding: 30px 20px; 
    }
    .icon {
      font-size: 48px;
      text-align: center;
      margin-bottom: 20px;
    }
    .title {
      font-size: 24px;
      font-weight: bold;
      color: #111827;
      margin: 0 0 15px 0;
      text-align: center;
    }
    .reply-box {
      background: #f9fafb;
      border-left: 4px solid #667eea;
      padding: 20px;
      margin: 20px 0;
      border-radius: 4px;
    }
    .from { 
      font-weight: 600; 
      color: #667eea;
      margin-bottom: 8px;
    }
    .subject {
      font-size: 18px;
      font-weight: 600;
      color: #111827;
      margin-bottom: 12px;
    }
    .preview {
      color: #4b5563;
      line-height: 1.8;
    }
    .action-button {
      display: inline-block;
      padding: 14px 28px;
      background: #667eea;
      color: white !important;
      text-decoration: none;
      border-radius: 6px;
      font-weight: 600;
      text-align: center;
      margin: 25px 0;
    }
    .footer { 
      text-align: center; 
      padding: 25px 20px; 
      color: #6b7280; 
      font-size: 14px; 
      background: #f9fafb;
      border-top: 1px solid #e5e7eb;
    }
  </style>
</head>
<body>
  <div class="container">
    <!-- Header -->
    <div class="header">
      <h1 style="margin: 0; font-size: 24px;">📧 New Email Reply</h1>
    </div>
    
    <!-- Content -->
    <div class="content">
      <div class="icon">📬</div>
      
      <h2 class="title">You have a reply from <%= @entity_name %></h2>
      
      <div class="reply-box">
        <div class="from">From: <%= @from_address %></div>
        <div class="subject"><%= @subject %></div>
        <div class="preview"><%= @preview %></div>
      </div>
      
      <div style="text-align: center;">
        <a href="<%= @full_link %>" class="action-button">
          View in Renter Insight
        </a>
      </div>
      
      <p style="color: #6b7280; font-size: 14px; text-align: center; margin-top: 20px;">
        This email was sent to a <%= @entity_type %> you manage in Renter Insight.
      </p>
    </div>
    
    <!-- Footer -->
    <div class="footer">
      <p style="margin: 0 0 10px 0;">
        You received this notification because you manage <%= @entity_name %> in Renter Insight.
      </p>
      
      <p style="margin: 15px 0 0 0; font-size: 12px; color: #9ca3af;">
        © <%= Time.current.year %> Renter Insight. All rights reserved.
      </p>
    </div>
  </div>
</body>
</html>
