<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    body { 
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
      line-height: 1.6; 
      color: #1f2937;
      background-color: #f9fafb;
      margin: 0;
      padding: 0;
    }
    .container { 
      max-width: 600px; 
      margin: 0 auto; 
      background: white;
      border-radius: 8px;
      overflow: hidden;
    }
    .header { 
      text-align: center; 
      padding: 30px 20px; 
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: white;
    }
    .logo { 
      max-width: 180px; 
      height: auto; 
      margin-bottom: 10px;
    }
    .company-name {
      font-size: 24px;
      font-weight: bold;
      margin: 0;
    }
    .category-badge {
      display: inline-block;
      padding: 6px 16px;
      border-radius: 20px;
      font-size: 14px;
      font-weight: 600;
      margin-top: 10px;
      background: rgba(255, 255, 255, 0.2);
    }
    .content { 
      padding: 30px 20px; 
    }
    .notification-icon {
      font-size: 48px;
      text-align: center;
      margin-bottom: 20px;
    }
    .notification-title {
      font-size: 24px;
      font-weight: bold;
      color: #111827;
      margin: 0 0 15px 0;
      text-align: center;
    }
    .notification-message {
      font-size: 16px;
      color: #4b5563;
      line-height: 1.8;
      margin: 20px 0;
      padding: 20px;
      background: #f9fafb;
      border-left: 4px solid #667eea;
      border-radius: 4px;
    }
    .priority-badge {
      display: inline-block;
      padding: 4px 12px;
      border-radius: 12px;
      font-size: 12px;
      font-weight: 600;
      text-transform: uppercase;
      margin-bottom: 15px;
    }
    .priority-high { background: #fee2e2; color: #991b1b; }
    .priority-medium { background: #fef3c7; color: #92400e; }
    .priority-low { background: #dbeafe; color: #1e40af; }
    .action-button {
      display: inline-block;
      padding: 14px 28px;
      background: #667eea;
      color: white !important;
      text-decoration: none;
      border-radius: 6px;
      font-weight: 600;
      text-align: center;
      margin: 25px 0;
      transition: background 0.2s;
    }
    .action-button:hover {
      background: #5568d3;
    }
    .metadata {
      background: #f9fafb;
      padding: 15px;
      border-radius: 6px;
      margin: 20px 0;
      font-size: 14px;
      color: #6b7280;
    }
    .metadata-row {
      display: flex;
      justify-content: space-between;
      padding: 8px 0;
      border-bottom: 1px solid #e5e7eb;
    }
    .metadata-row:last-child {
      border-bottom: none;
    }
    .footer { 
      text-align: center; 
      padding: 25px 20px; 
      color: #6b7280; 
      font-size: 14px; 
      background: #f9fafb;
      border-top: 1px solid #e5e7eb;
    }
    .footer-links {
      margin: 15px 0;
    }
    .footer-link {
      color: #667eea;
      text-decoration: none;
      margin: 0 10px;
    }
    @media only screen and (max-width: 600px) {
      .container {
        border-radius: 0;
      }
      .content {
        padding: 20px 15px;
      }
    }
  </style>
</head>
<body>
  <div class="container">
    <!-- Header -->
    <div class="header">
      <% if @company.present? && (@company.try(:logo_url).present? || @company.try(:logo).present?) %>
        <img src="<%= @company.try(:logo_url) || @company.try(:logo) %>" alt="<%= @company.name %>" class="logo">
      <% end %>
      
      <% 
        # Waterfall: Location name first, then Company name, then platform
        display_name = if @location.present? && @location.name.present?
          @location.name
        elsif @company.present?
          @company.name
        else
          'RenterInsight'
        end
      %>
      
      <h1 class="company-name"><%= display_name %></h1>
      
      <% if @location.present? && @company.present? && @location.name != @company.name %>
        <div style="color: rgba(255,255,255,0.8); font-size: 14px; margin-top: 5px;">
          <%= @company.name %>
        </div>
      <% end %>
      
      <div class="category-badge">
        <%= @category_config[:icon] %> <%= @notification.category.titleize %>
      </div>
    </div>
    
    <!-- Content -->
    <div class="content">
      <!-- Priority Badge -->
      <% if @notification.priority.present? %>
        <div style="text-align: center;">
          <span class="priority-badge priority-<%= @notification.priority %>">
            <%= @notification.priority.upcase %> PRIORITY
          </span>
        </div>
      <% end %>
      
      <!-- Notification Icon -->
      <div class="notification-icon">
        <%= @category_config[:icon] %>
      </div>
      
      <!-- Title -->
      <h2 class="notification-title"><%= @notification.title %></h2>
      
      <!-- Message -->
      <div class="notification-message">
        <%= simple_format(@notification.message) %>
      </div>
      
      <!-- Attachments -->
      <% if @notification.attachments.attached? %>
        <div style="margin-top: 20px; padding: 15px; background: #f3f4f6; border-radius: 6px;">
          <strong style="color: #374151; margin-bottom: 10px; display: block;">📎 Attachments:</strong>
          <ul style="list-style: none; padding: 0; margin: 0;">
            <% @notification.attachments.each do |attachment| %>
              <li style="padding: 8px 0; border-bottom: 1px solid #e5e7eb;">
                <strong><%= attachment.filename %></strong>
                <span style="color: #6b7280; font-size: 12px; margin-left: 8px;">
                  (<%= number_to_human_size(attachment.byte_size) %>)
                </span>
              </li>
            <% end %>
          </ul>
          <p style="color: #6b7280; font-size: 12px; margin-top: 10px;">
            ℹ️ Attachments are included with this email
          </p>
        </div>
      <% end %>
      
      <!-- Action Button -->
      <% if @action_url.present? %>
      <% 
        base_url = @frontend_url || 'https://localhost:5173'
        full_url = "#{base_url}#{@action_url}"
      %>
        <div style="text-align: center;">
          <a href="<%= full_url %>" class="action-button">
            <%= @action_text %>
          </a>
        </div>
      <% end %>
    </div>
    
    <!-- Footer -->
    <div class="footer">
      <p style="margin: 0 0 10px 0;">
        You received this notification because you are registered in <%= @company&.name || 'RenterInsight' %>.
      </p>
      
      <% if @location.present? %>
        <p style="margin: 10px 0;">
          <strong><%= @location.name %></strong><br>
          <% if @location.phone.present? %>
            Phone: <%= @location.phone %><br>
          <% end %>
          <% if @location.email.present? %>
            Email: <%= @location.email %>
          <% end %>
        </p>
      <% end %>
      
      <% 
        # Use environment-configured frontend URL (automatically correct for local/staging/production)
        frontend_url = ENV['FRONTEND_URL'] || Rails.application.credentials.dig(:frontend_url) || 'https://app.renterinsight.com'
      %>
      
      <div class="footer-links">
        <a href="<%= frontend_url %>/notifications" class="footer-link">
          View All Notifications
        </a>
        |
        <a href="<%= frontend_url %>/account/settings?tab=notifications" class="footer-link">
          Notification Preferences
        </a>
      </div>
      
      <p style="margin: 15px 0 0 0; font-size: 12px; color: #9ca3af;">
        © <%= Time.current.year %> <%= @company&.name || 'RenterInsight' %>. All rights reserved.
      </p>
    </div>
  </div>
</body>
</html>
