<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <style>
    body { font-family: Arial, sans-serif; line-height: 1.6; color: #1f2937; background: #f9fafb; margin: 0; padding: 0; }
    .container { max-width: 620px; margin: 0 auto; padding: 24px; background: white; }
    .header { padding: 8px 0 20px; border-bottom: 2px solid #e5e7eb; }
    .badge { display: inline-block; background: #dbeafe; color: #1d4ed8; padding: 4px 10px; border-radius: 999px; font-size: 12px; text-transform: uppercase; letter-spacing: 0.04em; }
    .badge.platform-instagram { background: #fce7f3; color: #be185d; }
    h1 { font-size: 22px; margin: 12px 0 4px; }
    .preview { border: 1px solid #e5e7eb; border-radius: 8px; padding: 16px; margin: 20px 0; background: #f9fafb; }
    .vehicle { color: #374151; font-size: 14px; margin-top: 6px; }
    .caption { white-space: pre-line; color: #111827; margin-top: 12px; }
    .cta { margin: 24px 0 12px; }
    .btn { display: inline-block; padding: 12px 22px; margin-right: 10px; border-radius: 6px; text-decoration: none; font-weight: 600; }
    .btn-primary { background: #2563eb; color: #ffffff; }
    .btn-secondary { background: #e5e7eb; color: #111827; }
    .btn-skip { background: transparent; color: #6b7280; padding-left: 0; }
    .footer { margin-top: 32px; padding-top: 16px; border-top: 1px solid #e5e7eb; color: #6b7280; font-size: 12px; }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <span class="badge platform-<%= @post.platform %>"><%= @post.platform.to_s.titleize %></span>
      <span class="badge" style="margin-left:6px;"><%= @post.intent_category.to_s.titleize %></span>
      <h1>Social Post Ready for Review</h1>
      <div style="color:#6b7280;font-size:14px;">Hi <%= @recipient.first_name.presence || @recipient.email %>, a new auto-generated post is waiting for your approval.</div>
    </div>

    <div class="preview">
      <% if @post.headline.present? %>
        <div style="font-weight:600;font-size:16px;"><%= @post.headline %></div>
      <% end %>
      <% if @vehicle.present? %>
        <div class="vehicle">
          Featured unit: <%= [@vehicle.year, @vehicle.make, @vehicle.model].compact.join(' ') %>
          <% if @vehicle.try(:sale_price).present? %>— $<%= number_with_delimiter(@vehicle.sale_price.to_i) %><% end %>
        </div>
      <% end %>
      <div class="caption"><%= truncate(@post.caption.to_s, length: 500) %></div>
    </div>

    <div class="cta">
      <a href="<%= @approve_url %>" class="btn btn-primary">Approve &amp; Publish</a>
      <a href="<%= @edit_url %>" class="btn btn-secondary">Edit Post</a>
      <a href="<%= @decline_url %>" class="btn btn-secondary" style="background:#fee2e2;color:#dc2626;margin-top:8px;">Decline</a>
      <br/>
      <a href="<%= @skip_url %>" class="btn btn-skip">Skip this post</a>
    </div>

    <div class="footer">
      You're receiving this because you're a designated approver for <%= @company.name %>. Approvers can always manage scheduled posts in Marketing → Social Media → Schedule.
    </div>
  </div>
</body>
</html>
