<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <style>
    body { font-family: Arial, sans-serif; line-height: 1.6; color: #333; }
    .container { max-width: 600px; margin: 0 auto; padding: 20px; }
    .header { background: #10b981; color: white; text-align: center; padding: 30px; border-radius: 8px 8px 0 0; }
    .header h1 { margin: 0; font-size: 24px; }
    .content { background: white; padding: 30px; border: 1px solid #e5e7eb; border-top: none; border-radius: 0 0 8px 8px; }
    .quote-info { background: #f3f4f6; padding: 20px; border-radius: 6px; margin: 20px 0; }
    .quote-info p { margin: 8px 0; }
    .view-button { display: inline-block; background: #dc2626; color: white; padding: 12px 30px; text-decoration: none; border-radius: 6px; margin: 20px 0; }
    .footer { text-align: center; padding: 20px 0; color: #6b7280; font-size: 0.9em; }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <h1>✓ Quote Accepted!</h1>
    </div>
    
    <div class="content">
      <p><strong>Great news!</strong></p>
      
      <p><%= @contact.full_name %> has accepted your quote.</p>
      
      <div class="quote-info">
        <p><strong>Quote Number:</strong> <%= @quote.quote_number %></p>
        <p><strong>Client:</strong> <%= @contact.full_name %></p>
        <p><strong>Email:</strong> <%= @contact.email %></p>
        <% if @contact.phone.present? %>
          <p><strong>Phone:</strong> <%= @contact.phone %></p>
        <% end %>
        <p><strong>Total:</strong> <%= number_to_currency(@quote.total) %></p>
        <p><strong>Accepted:</strong> <%= Time.current.strftime('%B %d, %Y at %I:%M %p') %></p>
      </div>
      
      <p>Next steps:</p>
      <ul>
        <li>Review the accepted quote in your dashboard</li>
        <li>Contact the client to proceed with next steps</li>
        <li>Update the quote status as needed</li>
      </ul>
      
      <div style="text-align: center;">
        <a href="<%= ENV['FRONTEND_URL'] || 'https://staging.crm.landlordinsight.com' %>/quotes/<%= @quote.id %>" class="view-button">View Quote in Dashboard</a>
      </div>
      
      <% if @quote.notes.present? %>
        <div style="margin: 20px 0; padding: 15px; background: #f9fafb; border-left: 4px solid #10b981;">
          <strong>Quote Notes:</strong><br>
          <%= simple_format(@quote.notes) %>
        </div>
      <% end %>
    </div>
    
    <div class="footer">
      <p>This is an automated notification from your RenterInsight platform.</p>
    </div>
  </div>
</body>
</html>
