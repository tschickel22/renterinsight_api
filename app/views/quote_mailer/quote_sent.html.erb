<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <style>
    body { font-family: Arial, sans-serif; line-height: 1.6; color: #333; }
    .container { max-width: 600px; margin: 0 auto; padding: 20px; }
    .header { text-align: center; padding: 20px 0; border-bottom: 2px solid #e5e7eb; }
    .logo { max-width: 200px; height: auto; }
    .quote-details { margin: 30px 0; }
    .quote-table { width: 100%; border-collapse: collapse; margin: 20px 0; }
    .quote-table th { background: #f3f4f6; padding: 12px; text-align: left; border-bottom: 2px solid #e5e7eb; }
    .quote-table td { padding: 12px; border-bottom: 1px solid #e5e7eb; }
    .total-row { font-weight: bold; font-size: 1.1em; background: #f9fafb; }
    .view-button { display: inline-block; background: #dc2626; color: white; padding: 12px 30px; text-decoration: none; border-radius: 6px; margin: 20px 0; }
    .footer { text-align: center; padding: 20px 0; color: #6b7280; font-size: 0.9em; border-top: 1px solid #e5e7eb; margin-top: 40px; }
    .valid-until { background: #fef3c7; padding: 12px; border-radius: 6px; margin: 20px 0; text-align: center; }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <% if @company.try(:logo_url).present? || @company.try(:logo).present? %>
        <img src="<%= @company.try(:logo_url) || @company.try(:logo) %>" alt="<%= @company.name %>" class="logo">
      <% else %>
        <h1><%= @company.name %></h1>
      <% end %>
    </div>
    
    <div class="quote-details">
      <h2>Quote <%= @quote.quote_number %></h2>
      
      <p>Hello <%= @contact.first_name %>,</p>
      
      <p>We've prepared a quote for you. Please review the details below.</p>
      
      <p><strong>Quote Date:</strong> <%= @quote.created_at.strftime('%B %d, %Y') %></p>
      
      <% if @quote.valid_until %>
        <div class="valid-until">
          <strong>Valid Until:</strong> <%= @quote.valid_until.strftime('%B %d, %Y') %>
        </div>
      <% end %>
      
      <% if @location %>
        <p><strong>From:</strong><br>
        <%= @location.name %><br>
        <% if @location.address_line1.present? %>
          <%= [@location.address_line1, @location.city, @location.state, @location.zip_code].compact.join(', ') %>
        <% end %>
        </p>
      <% end %>
    </div>
    
    <table class="quote-table">
      <thead>
        <tr>
          <th>Description</th>
          <th style="text-align: right;">Quantity</th>
          <th style="text-align: right;">Unit Price</th>
          <th style="text-align: right;">Amount</th>
        </tr>
      </thead>
      <tbody>
        <% @quote.items.each do |item| %>
          <tr>
            <td><%= item['description'] || item[:description] %></td>
            <td style="text-align: right;"><%= item['quantity'] || item[:quantity] %></td>
            <td style="text-align: right;"><%= number_to_currency(item['unitPrice'] || item['unit_price'] || item[:unitPrice] || item[:unit_price] || 0) %></td>
            <td style="text-align: right;"><%= number_to_currency(item['total'] || item[:total] || 0) %></td>
          </tr>
        <% end %>
        
        <tr>
          <td colspan="3" style="text-align: right;"><strong>Subtotal:</strong></td>
          <td style="text-align: right;"><%= number_to_currency(@subtotal) %></td>
        </tr>
        
        <% if @tax > 0 %>
          <tr>
            <td colspan="3" style="text-align: right;"><strong>Tax:</strong></td>
            <td style="text-align: right;"><%= number_to_currency(@tax) %></td>
          </tr>
        <% end %>
        
        <tr class="total-row">
          <td colspan="3" style="text-align: right;"><strong>Total:</strong></td>
          <td style="text-align: right;"><%= number_to_currency(@total) %></td>
        </tr>
      </tbody>
    </table>
    
    <% if @quote.notes.present? %>
      <div style="margin: 20px 0; padding: 15px; background: #f9fafb; border-left: 4px solid #dc2626;">
        <strong>Notes:</strong><br>
        <%= simple_format(@quote.notes) %>
      </div>
    <% end %>
    
    <div style="text-align: center;">
      <a href="<%= @quote_link %>" class="view-button">View Quote</a>
      <p style="color: #6b7280; font-size: 0.9em;">Click to view your quote (no login required)</p>
    </div>
    
    <div class="footer">
      <p><%= @company.name %></p>
      <% if @location.present? %>
        <% if @location.address_line1.present? %>
          <p><%= [@location.address_line1, @location.city, @location.state, @location.zip_code].compact.join(', ') %></p>
        <% end %>
        <% if @location.phone.present? %>
          <p>Phone: <%= @location.phone %></p>
        <% end %>
        <% if @location.email.present? %>
          <p>Email: <%= @location.email %></p>
        <% end %>
      <% end %>
    </div>
  </div>
</body>
</html>
